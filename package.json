{
  "name": "badawi-os",
  "version": "0.4.1",
  "private": true,
  "description": "A local-first personal workspace with user-controlled automation",
  "main": "dist-desktop/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "package": "npm run build && node scripts/package.mjs",
    "test:desktop": "node tests/desktop.mjs",
    "test:resources": "node tests/resources.mjs",
    "test:chat": "node tests/chat-desktop.mjs"
  },
  "dependencies": {
    "@siwc/local": "file:vendor/siwc-local",
    "lucide-react": "1.61.0",
    "luxon": "3.7.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/luxon": "3.7.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "electron": "45.0.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.58.2",
    "prettier": "3.9.10",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "type": "module",
  "overrides": {
    "esbuild": "0.28.2"
  }
}
